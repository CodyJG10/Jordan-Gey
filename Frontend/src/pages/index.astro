<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Master's Blueprint Landscapes</title>
		<meta
			name="description"
			content="Legacy outdoor living crafted with precision landscaping, hardscaping, and architectural detail."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="site-shell">
			<header class="topbar">
				<div class="brand">
					<span class="brand-name">Master's Blueprint Landscapes</span>
				</div>
				<nav aria-label="Primary">
					<ul>
						<li><a href="#">Portfolio</a></li>
						<li><a href="#">Services</a></li>
						<li><a href="#">Process</a></li>
						<li><a href="#">About</a></li>
						<li><a href="#">(555) 650-9346</a></li>
						<li><a class="nav-cta" href="#">Request a Quote</a></li>
					</ul>
				</nav>
			</header>

			<section class="hero" aria-label="Hero">
				<div class="hero-copy">
					<p class="eyebrow">Crafting Legacy Spaces Since 1988</p>
					<h1>Masterfully Crafted Outdoor Living Spaces</h1>
					<p>
						A legacy of building landscapes with meticulous craftsmanship and
						enduring quality to elevate your property.
					</p>
					<div class="hero-actions">
						<a href="#" class="btn btn-gold">Request a Free Quote Today</a>
						<a href="#" class="btn btn-dark">View Portfolio</a>
					</div>
				</div>

				<form class="inquiry-card" action="#" method="post">
					<h2>Instant Blueprint Inquiry</h2>
					<label>
						Your full name
						<input type="text" name="name" placeholder="John Doe" />
					</label>
					<label>
						Email
						<input type="email" name="email" placeholder="you@email.com" />
					</label>
					<label>
						Project type
						<select name="projectType">
							<option>Hardscaping &amp; Patios</option>
							<option>Outdoor Kitchens</option>
							<option>Retaining Walls</option>
							<option>Complete Landscape Design</option>
						</select>
					</label>
					<label>
						Budget range
						<input type="text" name="budget" placeholder="$20,000-$50,000" />
					</label>
					<button type="submit">Send Inquiry</button>
				</form>
			</section>

			<section class="precision">
				<div class="precision-head">
					<p class="eyebrow">The Master's Blueprint</p>
					<h2>Built on a Foundation of Precision and Heritage</h2>
				</div>
				<div class="precision-stats" aria-label="Company stats">
					<div>
						<strong>20+</strong>
						<span>Years Experience</span>
					</div>
					<div>
						<strong>100%</strong>
						<span>Satisfaction Focused</span>
					</div>
				</div>
				<div class="feature-grid">
					<article>
						<h3>Conceptual Design</h3>
						<p>
							Every masterpiece begins with a thoughtful plan that aligns vision
							and function.
						</p>
					</article>
					<article>
						<h3>Expert Engineering</h3>
						<p>
							Our technical team engineers each element to ensure longevity and
							flawless installation.
						</p>
					</article>
					<article>
						<h3>Flawless Finishes</h3>
						<p>
							Luxury detail work where durable materials and refined craft produce
							timeless value.
						</p>
					</article>
				</div>
			</section>

			<section class="services" id="services">
				<p class="eyebrow">Signature Blueprints</p>
				<h2>Our Signature Services</h2>
				<div class="service-grid">
					<article>
						<img src="https://images.unsplash.com/photo-1592229505726-ca121723b8ef?auto=format&fit=crop&w=800&q=80" alt="Driveway paving" loading="lazy" />
						<h3>Driveway Pavers</h3>
						<p>
							Custom paver driveways engineered for curb appeal and long-term
							durability.
						</p>
						<a href="#">Explore Design</a>
					</article>
					<article>
						<img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80" alt="Patio deck detail" loading="lazy" />
						<h3>Patios &amp; Pool Decks</h3>
						<p>
							Refined outdoor surfaces that blend architecture with comfort and
							elegance.
						</p>
						<a href="#">Explore Design</a>
					</article>
					<article>
						<img src="https://images.unsplash.com/photo-1632157686659-fba966f13385?auto=format&fit=crop&w=800&q=80" alt="Outdoor kitchen installation" loading="lazy" />
						<h3>Outdoor Kitchens</h3>
						<p>
							Performance-ready kitchens crafted with weather-resistant premium
							materials.
						</p>
						<a href="#">Explore Design</a>
					</article>
					<article>
						<img src="https://images.unsplash.com/photo-1592878849122-5da98f8e66f8?auto=format&fit=crop&w=800&q=80" alt="Stone retaining wall" loading="lazy" />
						<h3>Retaining Walls</h3>
						<p>
							Structural stonework thoughtfully designed to define levels and
							stabilize landscapes.
						</p>
						<a href="#">Explore Design</a>
					</article>
				</div>
			</section>

			<section class="testimonials">
				<div class="quotes">
					<p class="eyebrow">Client Review</p>
					<h2>What Our Clients Say</h2>
					<div class="quote-grid">
						<article>
							<p class="stars">★★★★★</p>
							<p>
								"The attention to detail was extraordinary. Our outdoor space feels
								like a refined retreat. Truly the benchmark for craft."
							</p>
							<span>Russell Sutton</span>
						</article>
						<article>
							<p class="stars">★★★★★</p>
							<p>
								"Everything was managed beyond expectations. Their process felt
								premium from design through final installation."
							</p>
							<span>Monica Chen</span>
						</article>
					</div>
				</div>
				<aside class="service-area">
					<h3>Service Areas We Cover</h3>
					<ul>
						<li>North Downtown Estates</li>
						<li>Upper Brookside</li>
						<li>Harbor Oak Valley</li>
						<li>West Ridge Preserve</li>
						<li>Grand Maple Terrace</li>
					</ul>
					<div class="office-hours">
						<p>Office Hours</p>
						<span>Mon-Fri, 8:00 AM to 6:00 PM</span>
					</div>
				</aside>
			</section>

			<section class="cta-band">
				<h2>Ready to define your outdoor legacy?</h2>
				<p>
					Contact the master builders today for a comprehensive site
					evaluation and bespoke consultation.
				</p>
				<a href="#" class="btn btn-gold">Request a Free Quote Today</a>
			</section>

			<footer class="site-footer">
				<div>
					<h3>Master's Blueprint Landscapes</h3>
					<p>
						From legacy hardscaping to luxury outdoor rooms, we design and craft
						signature spaces built to endure.
					</p>
				</div>
				<div>
					<h4>Services</h4>
					<a href="#">Driveway Pavers</a>
					<a href="#">Patios</a>
					<a href="#">Outdoor Kitchens</a>
				</div>
				<div>
					<h4>Company</h4>
					<a href="#">Home</a>
					<a href="#">Portfolio</a>
					<a href="#">Planning</a>
				</div>
				<div>
					<h4>Contact</h4>
					<p>hello@mastersblueprint.com</p>
					<p>(555) 650-9346</p>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		--bg: #dfe2e6;
		--surface: #f6f7f8;
		--green-900: #0c3b2d;
		--green-800: #114a38;
		--green-700: #1b604a;
		--gold: #d8b062;
		--ink: #14221e;
		--muted: #56635f;
		--line: #ccd1d6;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: "Work Sans", sans-serif;
		background: radial-gradient(circle at 10% -20%, #e8ecef 0%, var(--bg) 45%),
			linear-gradient(180deg, #e4e8ec 0%, #d9dde2 100%);
		color: var(--ink);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-shell {
		max-width: 1160px;
		margin: 0 auto;
		background: var(--bg);
		box-shadow: 0 20px 70px rgba(14, 24, 20, 0.16);
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: var(--surface);
		padding: 1rem 1.5rem;
		border-bottom: 1px solid var(--line);
	}

	.brand-name {
		font-size: 0.86rem;
		letter-spacing: 0.02em;
		font-weight: 600;
		color: #1f3e34;
	}

	nav ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		gap: 1rem;
		align-items: center;
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 600;
		color: #325244;
	}

	.nav-cta {
		background: var(--green-900);
		color: #fff;
		padding: 0.7rem 1rem;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 350px;
		gap: 2rem;
		padding: 2.2rem 2rem;
		min-height: 540px;
		background: linear-gradient(120deg, rgba(8, 42, 34, 0.72), rgba(18, 62, 48, 0.58)),
			url("https://images.unsplash.com/photo-1618220252344-8ec99ec624b1?auto=format&fit=crop&w=1800&q=80")
				center/cover no-repeat;
		border-bottom: 1px solid #9ba7a0;
	}

	.eyebrow {
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 600;
		color: #6f7f78;
	}

	.hero .eyebrow {
		color: #c4d6cc;
	}

	.hero-copy {
		max-width: 560px;
		margin-top: auto;
		margin-bottom: 1.3rem;
		animation: rise 650ms ease-out both;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: "Cormorant Garamond", serif;
		margin: 0;
		font-weight: 600;
	}

	h1 {
		font-size: clamp(2.2rem, 4vw, 3.6rem);
		line-height: 0.95;
		color: #fff;
		margin: 0.9rem 0;
	}

	.hero-copy p {
		margin: 0;
		color: #dce9e1;
		max-width: 50ch;
		line-height: 1.6;
		font-size: 0.94rem;
	}

	.hero-actions {
		display: flex;
		gap: 0.7rem;
		margin-top: 1.4rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1.15rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-weight: 700;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
	}

	.btn-gold {
		background: var(--gold);
		color: #2d2819;
	}

	.btn-dark {
		background: rgba(8, 36, 29, 0.88);
		color: #fff;
	}

	.inquiry-card {
		background: #fbfcfd;
		padding: 1.2rem;
		border: 1px solid #d5dadf;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		align-self: center;
		animation: rise 800ms ease-out both;
	}

	.inquiry-card h2 {
		font-size: 1.6rem;
		color: #2b3d35;
		margin-bottom: 0.2rem;
	}

	label {
		display: flex;
		flex-direction: column;
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #5b6a66;
		gap: 0.35rem;
	}

	input,
	select,
	button {
		font: inherit;
	}

	input,
	select {
		padding: 0.67rem;
		border: 1px solid #d1d8dd;
		background: #fff;
		font-size: 0.84rem;
	}

	button {
		padding: 0.82rem 1rem;
		margin-top: 0.3rem;
		border: 0;
		background: var(--green-900);
		color: #fff;
		text-transform: uppercase;
		font-size: 0.67rem;
		letter-spacing: 0.14em;
		font-weight: 700;
		cursor: pointer;
	}

	.precision,
	.services,
	.testimonials,
	.site-footer {
		padding: 3rem 2rem;
	}

	.precision-head {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1rem;
		align-items: end;
		border-bottom: 1px solid var(--line);
		padding-bottom: 1.25rem;
	}

	.precision h2,
	.services h2,
	.testimonials h2,
	.cta-band h2 {
		font-size: clamp(2rem, 2.9vw, 3rem);
		line-height: 0.95;
		color: #25382f;
	}

	.precision-stats {
		display: flex;
		gap: 1.25rem;
	}

	.precision-stats div {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		border-left: 2px solid #87a499;
		padding-left: 0.7rem;
	}

	.precision-stats strong {
		font-family: "Cormorant Garamond", serif;
		font-size: 1.5rem;
		color: var(--green-800);
	}

	.precision-stats span {
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 600;
		color: #5e7169;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.6rem;
	}

	.feature-grid article {
		background: #f2f4f6;
		border: 1px solid var(--line);
		padding: 1.15rem;
		min-height: 170px;
	}

	.feature-grid h3 {
		font-size: 1.35rem;
		color: #20342c;
		margin-bottom: 0.6rem;
	}

	.feature-grid p,
	.service-grid p,
	.quotes p,
	.site-footer p {
		color: #4f5e59;
		line-height: 1.55;
		font-size: 0.9rem;
	}

	.services {
		text-align: center;
	}

	.services .eyebrow,
	.services h2 {
		text-align: center;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.8rem;
		text-align: left;
	}

	.service-grid article {
		border: 1px solid var(--line);
		background: #f7f8f9;
		padding-bottom: 1rem;
	}

	.service-grid img {
		width: 100%;
		height: 158px;
		object-fit: cover;
		display: block;
	}

	.service-grid h3 {
		font-size: 1.3rem;
		padding: 0.8rem 0.8rem 0;
		color: #223a31;
	}

	.service-grid p {
		padding: 0 0.8rem;
		min-height: 88px;
	}

	.service-grid a {
		display: inline-block;
		margin-left: 0.8rem;
		font-size: 0.66rem;
		text-transform: uppercase;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--green-800);
	}

	.testimonials {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 1rem;
		align-items: start;
	}

	.quote-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.quote-grid article {
		background: #f5f7f8;
		border: 1px solid var(--line);
		padding: 1rem;
	}

	.stars {
		font-size: 0.76rem;
		letter-spacing: 0.05em;
		color: #b28d45;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.quote-grid span {
		font-size: 0.75rem;
		font-weight: 600;
		color: #4d5e59;
	}

	.service-area {
		background: var(--green-900);
		padding: 1.2rem;
		color: #f8fbfa;
	}

	.service-area h3 {
		font-size: 1.5rem;
		margin-bottom: 0.8rem;
	}

	.service-area ul {
		padding-left: 1.1rem;
		margin: 0;
		display: grid;
		gap: 0.52rem;
		font-size: 0.84rem;
		color: #d5e6de;
	}

	.office-hours {
		margin-top: 1rem;
		padding-top: 0.9rem;
		border-top: 1px solid rgba(217, 236, 228, 0.25);
	}

	.office-hours p {
		margin: 0;
		color: #f2f8f5;
		font-weight: 600;
	}

	.office-hours span {
		font-size: 0.8rem;
		color: #c6dbd1;
	}

	.cta-band {
		text-align: center;
		padding: 4.2rem 2rem;
		background: linear-gradient(180deg, rgba(10, 57, 43, 0.96) 0%, rgba(7, 45, 34, 0.95) 100%),
			radial-gradient(circle at 20% 10%, rgba(95, 140, 111, 0.32), transparent 60%);
		color: #f7faf8;
	}

	.cta-band h2 {
		color: #fbfefc;
	}

	.cta-band p {
		max-width: 62ch;
		margin: 1rem auto 1.4rem;
		color: #c4ddd2;
		font-size: 0.92rem;
	}

	.site-footer {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 1.5rem;
		border-top: 1px solid var(--line);
		background: #d8dde2;
	}

	.site-footer h3 {
		font-size: 1.4rem;
		margin-bottom: 0.5rem;
	}

	.site-footer h4 {
		font-size: 1.18rem;
		margin-bottom: 0.5rem;
		color: #294036;
	}

	.site-footer a,
	.site-footer p {
		display: block;
		font-size: 0.82rem;
		margin: 0.35rem 0;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 1024px) {
		nav ul {
			gap: 0.7rem;
			font-size: 0.68rem;
		}

		.hero {
			grid-template-columns: 1fr;
			padding: 1.6rem;
			min-height: auto;
		}

		.inquiry-card {
			max-width: 380px;
		}

		.feature-grid {
			grid-template-columns: 1fr;
		}

		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.testimonials {
			grid-template-columns: 1fr;
		}

		.site-footer {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 740px) {
		.topbar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
		}

		nav ul {
			flex-wrap: wrap;
		}

		.precision,
		.services,
		.testimonials,
		.site-footer,
		.cta-band {
			padding: 2.1rem 1rem;
		}

		.precision-head {
			grid-template-columns: 1fr;
		}

		.quote-grid,
		.service-grid,
		.site-footer {
			grid-template-columns: 1fr;
		}

		h1 {
			font-size: 2.1rem;
		}
	}
</style>
